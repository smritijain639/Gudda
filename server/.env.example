# Port the API listens on
PORT=3001

# Origin allowed for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# The Veeva Vault instance this tool connects to
VAULT_DNS=https://sb-roche-rim-development.veevavault.com

# Default Veeva Vault REST API version
VAULT_API_VERSION=v24.1

# Extra security profiles to treat as admin (comma-separated), in addition to
# the built-in business_admin__v / vault_owner__v / system_admin__v.
# VAULT_ADMIN_PROFILES=rim_admin__c

# --- Roche Galileo LLM (natural-language search) ---------------------------
# Required to enable the "Ask (AI)" search mode.
# Confirmed working config for the Roche AI Gateway (Portkey-fronted):
GALILEO_API_KEY=
GALILEO_URL=https://us.aigw.galileo.roche.com/v1/chat/completions
GALILEO_AUTH_HEADER=Authorization
# Quote the prefix so the trailing space is preserved by the .env loader.
GALILEO_AUTH_PREFIX="Bearer "
GALILEO_MODEL=gemini-2.5-flash
GALILEO_BODY_STYLE=chat
GALILEO_RESPONSE_PATH=choices.0.message.content
# Note: the EU gateway (eu.aigw.galileo.roche.com) rejected this key; use US.
# Allowed models on this integration include gemini-2.5-flash and gemini-2.5-pro.
# Optional extra headers as JSON, e.g. {"api-version":"2024-02-01"}
# GALILEO_EXTRA_HEADERS=

# Session lifetime in milliseconds (default 30 minutes)
SESSION_TTL_MS=1800000
